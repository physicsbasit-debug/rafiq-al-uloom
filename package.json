{
  "name": "rafiq-al-uloom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:supabase": "RUN_SUPABASE_INTEGRATION_TESTS=true vitest run --config vitest.supabase.config.ts",
    "test:mastery-results-composition": "RUN_SUPABASE_INTEGRATION_TESTS=true vitest run --config vitest.supabase.config.ts tests/integration/supabase-mastery-composition.integration.tsx",
    "test:mastery-results-parity": "RUN_SUPABASE_INTEGRATION_TESTS=true vitest run --config vitest.supabase.config.ts tests/integration/supabase-mastery-scoring-parity.integration.ts",
    "verify:auth-closure": "bash scripts/verify-auth-security.sh",
    "verify:mastery-results-closure": "bash scripts/verify-mastery-results-closure.sh",
    "verify:phase-3-closure": "bash scripts/verify-phase-3-closure.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "@tailwindcss/vite": "^4.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "supabase": "2.110.0",
    "tsx": "4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
